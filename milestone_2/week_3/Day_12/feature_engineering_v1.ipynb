      "source": [
        "#### 2. Calculate Damage Potential Using HAZUS-Style Formula"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "id": "8d509a07",
      "metadata": {
        "id": "8d509a07"
      },
      "outputs": [],
      "source": [
        "def calculate_damage_potential_hazus(magnitude, depth):\n",
        "    \"\"\"Calculate earthquake damage potential using HAZUS methodology.\"\"\"\n",
        "    actual_depth = max(abs(depth), 1.0)  # Ensure depth is at least 1 km to avoid log(0)\n",
        "    log_pga = magnitude - 3.5 * np.log10(actual_depth + 7) + 1.8 # HAZUS empirical formula\n",
        "    pga = 10 ** log_pga  # Convert log10(PGA) to PGA in g\n",
        "    # Calculate damage potential score (0 to 10 scale)\n",
        "    damage_potential = min(10.0, max(0.0, 2.5 * np.log10(pga + 0.01) + 7.5))\n",
        "    # Return the final damage potential score\n",
        "    return damage_potential"
      ]
    },
